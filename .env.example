# Copy to .env and fill in. .env is gitignored — keys are never committed.
# Load without a library: export $(grep -v '^#' .env | xargs)

PORT=8080

# Shared secret app <-> backend (X-Api-Key header). Generate one: openssl rand -hex 32
APP_API_KEY=change-me

# LLM provider key (ProxyAPI). Lives ONLY here, on the backend.
PROVIDER_API_KEY=your-proxyapi-key

LLM_BASE_URL=https://api.proxyapi.ru/openai/v1/chat/completions
DEFAULT_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECS=120

# Web OAuth client ID from Google Cloud Console: the `aud` claim of Google
# ID-tokens. Required unless ACCEPT_DEV_TOKENS=1 (local testing only).
GOOGLE_CLIENT_ID=

# Local testing only: accept "dev:<user_id>" bearer tokens instead of real
# Google ID-tokens. Never enable in production.
ACCEPT_DEV_TOKENS=

# Postgres for task sync. docker compose wires DATABASE_URL to the db service;
# POSTGRES_* initialize the database itself. Password: openssl rand -hex 16.
POSTGRES_USER=mytasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mytasks
DATABASE_URL=postgres://mytasks:change-me@db:5432/mytasks?sslmode=disable

# Host port the backend is published on (VPS: 80, local: 8080)
BACKEND_PORT=8080

# Public hostname for Caddy TLS termination (e.g. myhome.duckdns.org);
# must point at this machine's public IP, external port 443 forwarded.
DOMAIN=
