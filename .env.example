# Copy to .env and fill in. .env is gitignored — keys are never committed.
# Load without a library: export $(grep -v '^#' .env | xargs)

PORT=8080

# Shared secret app <-> backend (X-Api-Key header). Generate one: openssl rand -hex 32
APP_API_KEY=change-me

# LLM provider key (ProxyAPI). Lives ONLY here, on the backend.
PROVIDER_API_KEY=your-proxyapi-key

LLM_BASE_URL=https://api.proxyapi.ru/openai/v1/chat/completions
DEFAULT_MODEL=gpt-5.4-mini
LLM_TIMEOUT_SECS=120
