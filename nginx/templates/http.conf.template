# HTTP vhost: ACME challenges + redirect to https. Rendered by sed
# (see the nginx service command in docker-compose.yml) — the ${DOMAIN}
# placeholder is replaced with the DOMAIN env var at container start.

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
